#!/bin/sh
# Fake Wrangler. Logs "SERVICE: wrangler ARGS" to $FAKE_LOG. The credential-
# free `wrangler` service refuses real deploys, like the real one would
# without a token.
set -eu
printf '%s: %s\n' "$SERVICE" "$*" >>"$FAKE_LOG"
[ "${1:-}" = "wrangler" ] && shift
case "${1:-}" in
  --version) echo " ⛅️ wrangler 4.156.2" ;;
  whoami)
    echo "You are logged in with an API Token."
    echo "| Account Name | Account ID |"
    echo "| Example | ${FAKE_WHOAMI_ACCOUNT:-} |"
    ;;
  deployments)
    echo '[{"id":"d1","versions":[{"version_id":"22222222-2222-4222-8222-222222222222","percentage":100}]}]'
    ;;
  deploy)
    case "$*" in
      *--dry-run*)
        echo "Total Upload: 0.00 KiB"
        echo "--dry-run: exiting now."
        ;;
      *)
        [ "$SERVICE" = "wrangler-deploy" ] || { echo "In a non-interactive environment, it's necessary to set a CLOUDFLARE_API_TOKEN" >&2; exit 1; }
        echo "Uploaded tylerbaum"
        echo "Current Version ID: 11111111-1111-4111-8111-111111111111"
        ;;
    esac
    ;;
  rollback) echo "Worker Version $2 has been deployed to 100% of traffic." ;;
  *) echo "fake wrangler: unexpected $*" >&2; exit 1 ;;
esac
