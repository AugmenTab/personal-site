# Deployment tooling image: Node and a pinned Wrangler, nothing else.
#
# The site is generated by the Haskell build (site-build service); this
# image only validates the Cloudflare configuration and uploads the
# already-packaged files in .release/public. It never compiles or bundles
# the site. Base pinned by tag and digest; Wrangler pinned by lockfile.
FROM node:22.12.0-bookworm-slim@sha256:35531c52ce27b6575d69755c73e65d4468dba93a25644eed56dc12879cae9213

# The local Workers runtime (workerd, used by `wrangler dev`) needs the
# system CA bundle; the slim base image does not include it.
RUN apt-get update \
 && apt-get install -qq -y --no-install-recommends ca-certificates \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/release
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
 && npm cache clean --force

# Wrangler on PATH; no usage metrics; never open a browser for login (API
# token authentication only, see docs/operations/deployment.md).
ENV PATH=/opt/release/node_modules/.bin:$PATH \
    WRANGLER_SEND_METRICS=false \
    CI=true

WORKDIR /work
CMD ["wrangler", "--version"]
