#!/bin/sh
# Fake Git for the release guardrail tests: answers only the queries
# scripts/release.sh makes, from FAKE_* variables.
set -eu
printf 'git %s\n' "$*" >>"$FAKE_LOG"
case "$*" in
  "rev-parse --verify HEAD") echo "$FAKE_HEAD" ;;
  "status --porcelain --untracked-files=no") [ -z "${FAKE_DIRTY:-}" ] || printf '%s\n' "$FAKE_DIRTY" ;;
  "status --porcelain")
    [ -z "${FAKE_DIRTY:-}" ] || printf '%s\n' "$FAKE_DIRTY"
    [ -z "${FAKE_UNTRACKED:-}" ] || printf '%s\n' "$FAKE_UNTRACKED"
    ;;
  "status --short") [ -z "${FAKE_DIRTY:-}${FAKE_UNTRACKED:-}" ] || printf '%s\n%s\n' "${FAKE_DIRTY:-}" "${FAKE_UNTRACKED:-}" ;;
  cat-file\ -e\ *)
    want=${3%^\{commit\}}
    case " ${FAKE_KNOWN:-} " in *" $want "*) exit 0 ;; *) exit 1 ;; esac
    ;;
  merge-base\ --is-ancestor\ *) [ -n "${FAKE_ON_MAIN:-}" ] ;;
  *) echo "fake git: unexpected $*" >&2; exit 1 ;;
esac
